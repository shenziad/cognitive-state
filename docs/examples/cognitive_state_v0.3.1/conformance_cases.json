          "source_refs": [
            "e1"
          ],
          "handle": "job-17"
        }
      ],
      "expected_finish_completed": false,
      "reason": "Match job identity before changing phase.",
      "counterexample": {
        "entity_id": "job-17",
        "phase": "succeeded",
        "source_refs": [
          "e2"
        ],
        "error": "wrong_entity_evidence"
      }
    },
