    {
      "id": "unordered_conflict",
      "user_goal": "Complete job-17 successfully.",
      "public_events": [
        {
          "id": "e1",
          "role": "tool",
          "content": "Contract: definitive submit response for attempt-1: accepted, job_id=job-17; job status accepted, result not ready."
        },
        {
          "id": "e2",
          "role": "tool",
          "content": "job-17 succeeded; no version or ordering guarantee."
        },
        {
          "id": "e3",
          "role": "tool",
          "content": "job-17 failed; no version or ordering guarantee. The public contract provides a current-status query."
        }
      ],
      "expected_operations": [
        {
          "id": "s1",
          "kind": "submission",
          "entity_id": "attempt-1",
          "operation": "submit_job",
          "phase": "completed",
          "source_refs": [
            "e1"
          ],
          "outcome": "accepted",
          "job_ref": "j1"
        },
        {
          "id": "j1",
          "kind": "job",
          "entity_id": "job-17",
          "operation": "submit_job",
          "phase": "unknown",
          "source_refs": [
            "e2",
            "e3"
          ],
          "handle": "job-17"
        }
      ],
      "expected_finish_completed": false,
      "reason": "Keep conflicting evidence and resolve via public query; do not arbitrarily choose a terminal state.",
      "counterexample": {
        "action": "finish_completed",
        "error": "unresolved_conflicting_evidence"
      }
