    {
      "id": "plan_only",
      "user_goal": "Apply setting gold.",
      "public_events": [
        {
          "id": "e1",
          "role": "assistant",
          "content": "Plan to call apply_setting. No call issued."
        }
      ],
      "expected_operations": [
        {
          "id": "o1",
          "kind": "sync_operation",
          "entity_id": "planned-1",
          "operation": "apply_setting",
