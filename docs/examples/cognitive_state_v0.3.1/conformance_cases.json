    {
      "id": "cancel_accepted",
      "user_goal": "Cancel job-17 and confirm cancellation.",
      "public_events": [
        {
          "id": "e1",
          "role": "tool",
          "content": "Contract: definitive submit response for attempt-1: accepted, job_id=job-17; job status accepted, result not ready."
        },
        {
          "id": "e3",
          "role": "tool",
          "content": "cancel attempt cancel-1 accepted for job-17; job remains running, sequence=2."
        }
      ],
      "expected_operations": [
        {
          "id": "s1",
          "kind": "submission",
          "entity_id": "attempt-1",
          "operation": "submit_job",
          "phase": "completed",
          "source_refs": [
            "e1"
          ],
          "outcome": "accepted",
          "job_ref": "j1"
        },
        {
          "id": "s2",
          "kind": "submission",
          "entity_id": "cancel-1",
          "operation": "cancel_job",
          "phase": "completed",
          "source_refs": [
            "e3"
          ],
          "outcome": "accepted",
          "job_ref": "j1"
        },
        {
          "id": "j1",
          "kind": "job",
          "entity_id": "job-17",
          "operation": "submit_job",
          "phase": "running",
          "source_refs": [
            "e3"
