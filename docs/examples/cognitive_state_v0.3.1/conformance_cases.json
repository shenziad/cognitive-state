{
  "schema_version": "v0.3.1",
  "purpose": "Offline normative examples only, not model input, gold-conditioned baseline, or full execution benchmark",
  "cases": [
    {
      "id": "accepted_pending",
      "user_goal": "Complete job-17 successfully.",
      "public_events": [
        {
          "id": "e1",
          "role": "tool",
          "content": "Contract: definitive submit response for attempt-1: accepted, job_id=job-17; job status accepted, result not ready."
        }
      ],
      "expected_operations": [
        {
          "id": "s1",
          "kind": "submission",
          "entity_id": "attempt-1",
          "operation": "submit_job",
          "phase": "completed",
          "source_refs": [
            "e1"
          ],
          "outcome": "accepted",
          "job_ref": "j1"
        },
        {
          "id": "j1",
          "kind": "job",
          "entity_id": "job-17",
          "operation": "submit_job",
          "phase": "accepted",
          "source_refs": [
            "e1"
          ],
          "handle": "job-17"
        }
      ],
      "expected_finish_completed": false,
      "reason": "Submission is complete with outcome accepted; the job is pending.",
      "counterexample": {
        "field": "job.phase",
        "value": "succeeded",
        "error": "unsupported_job_success"
      }
    },
    {
      "id": "submission_only_goal",
      "user_goal": "Submit the job and report its accepted ID. Do not wait for job completion.",
      "public_events": [
        {
          "id": "e1",
          "role": "tool",
          "content": "Contract: definitive submit response for attempt-1: accepted, job_id=job-17; job status accepted, result not ready."
        }
      ],
      "expected_operations": [
        {
          "id": "s1",
          "kind": "submission",
          "entity_id": "attempt-1",
          "operation": "submit_job",
          "phase": "completed",
          "source_refs": [
            "e1"
          ],
          "outcome": "accepted",
          "job_ref": "j1"
        },
        {
          "id": "j1",
          "kind": "job",
          "entity_id": "job-17",
          "operation": "submit_job",
          "phase": "accepted",
          "source_refs": [
            "e1"
          ],
          "handle": "job-17"
        }
      ],
      "expected_finish_completed": true,
      "reason": "Acceptance satisfies a submission-only goal; job remains accepted.",
      "counterexample": null
    },
    {
      "id": "submission_timeout",
      "user_goal": "Complete the requested job without duplicate submission.",
      "public_events": [
        {
          "id": "e1",
          "role": "tool",
          "content": "attempt-1 timed out; server acceptance and side effects unknown; no job ID received. Public interface offers idempotency lookup."
        }
      ],
      "expected_operations": [
        {
          "id": "s1",
          "kind": "submission",
          "entity_id": "attempt-1",
          "operation": "submit_job",
          "phase": "unknown",
          "source_refs": [
            "e1"
          ],
          "outcome": "unknown"
        }
      ],
      "expected_finish_completed": false,
      "reason": "Unknown acceptance does not license resubmission or invented job identity.",
      "counterexample": {
        "action": "resubmit_without_recovery",
        "error": "unsupported_no_side_effect_assumption"
      }
    },
    {
      "id": "other_job_succeeded",
