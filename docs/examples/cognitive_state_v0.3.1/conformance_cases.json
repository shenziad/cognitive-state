          "source_refs": [
            "e1"
          ]
        }
      ],
      "expected_finish_completed": false,
      "reason": "A plan cannot establish effects.",
      "counterexample": {
        "field": "sync_operation.phase",
        "value": "succeeded",
        "error": "plan_as_observation"
      }
    },
    {
      "id": "late_older_receipt",
      "user_goal": "Complete job-17 and save result v1.",
      "public_events": [
        {
          "id": "e1",
